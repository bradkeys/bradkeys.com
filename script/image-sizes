#!/bin/bash
# Regenerates _data/image_sizes.yml (path -> [width, height]) so templates can
# emit width/height attributes and avoid layout shift. Run after adding images.
cd "$(dirname "$0")/.."
out=_data/image_sizes.yml
echo "# Generated by script/image-sizes. Do not edit." > "$out"
find img -type f \( -name '*.jpg' -o -name '*.png' \) | sort | while read -r f; do
    w=$(sips -g pixelWidth "$f" | awk '/pixelWidth/ {print $2}')
    h=$(sips -g pixelHeight "$f" | awk '/pixelHeight/ {print $2}')
    echo "\"/$f\": [$w, $h]" >> "$out"
done
