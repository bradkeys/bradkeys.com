#!/bin/bash
# Generates 320x320 center-cropped square JPEG thumbnails of the portfolio
# screenshots into img/portfolio/thumbs/ (the project pages show them at 160px
# and open the full image in the lightbox). Only screenshots listed under `images:` in
# _data/portfolio.yml are processed. Run after adding screenshots, then run
# script/image-sizes. Needs macOS `sips`.
cd "$(dirname "$0")/.."
mkdir -p img/portfolio/thumbs
grep -E '^      - .*\.(jpg|png)$' _data/portfolio.yml | sed -E 's/^      - //' | sort -u | while read -r f; do
    out="img/portfolio/thumbs/${f%.*}.jpg"
    [ "$out" -nt "img/portfolio/$f" ] && continue
    w=$(sips -g pixelWidth "img/portfolio/$f" | awk '/pixelWidth/ {print $2}')
    h=$(sips -g pixelHeight "img/portfolio/$f" | awk '/pixelHeight/ {print $2}')
    # Scale the short side to 320, then crop the long side around the center.
    if [ "$w" -gt "$h" ]; then resize=(--resampleHeight 320); else resize=(--resampleWidth 320); fi
    sips -s format jpeg -s formatOptions 72 "${resize[@]}" --cropToHeightWidth 320 320 "img/portfolio/$f" --out "$out" >/dev/null
done
